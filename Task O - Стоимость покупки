import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner console = new Scanner(System.in);

        int a = console.nextInt();
        int b = console.nextInt();
        int n = console.nextInt();

        int total = (a * 100 + b) * n;

        int r = total / 100;
        int k = total % 100;

        System.out.println(r + " " + k);
    }
}

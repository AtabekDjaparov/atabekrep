import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        int n = scanner.nextInt();
        int d1 = n / 1000;
        int d2 = (n / 100) % 10;
        int d3 = (n / 10) % 10;
        int d4 = n % 10;
        int diff1 = d1 - d4;
        int diff2 = d2 - d3;
        int result = diff1 * diff1 + diff2 * diff2 + 1;
        System.out.println(result);
    }
}

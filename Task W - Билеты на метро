import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        int n = scanner.nextInt();
        
        int n60 = n / 60;
        n %= 60;
        
        int n10 = n / 10;
        int n1 = n % 10;
        
        if (n1 * 15 >= 125) {
            n10++;
            n1 = 0;
        }
        
        if (n10 * 125 + n1 * 15 >= 440) {
            n60++;
            n10 = 0;
            n1 = 0;
        }
        
        System.out.println(n1 + " " + n10 + " " + n60);
    }
}

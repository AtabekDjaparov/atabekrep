import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        int a = scanner.nextInt();
        int b = scanner.nextInt();
        int s = (a / b + 999) / 1000;
        int result = a * s + b * (1 - s);
        System.out.println(result);
    }
}

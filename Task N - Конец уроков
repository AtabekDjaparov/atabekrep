import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner console = new Scanner(System.in);

        int n = console.nextInt();

        int minutes = 45 * n + 5 * (n / 2) + 15 * ((n - 1) / 2);

        int hours = 9 + minutes / 60;
        int mins = minutes % 60;

        System.out.println(hours + " " + mins);
    }
}
